{
  "contractVersion": "0.1.0",
  "wireEncoding": {
    "counter": "unsigned decimal string",
    "timestamp": "integer milliseconds since Unix epoch within 0..9007199254740991",
    "optional": "field omitted; null only where schema explicitly permits",
    "enum": "closed for commands; receivers preserve unknown event/error values for diagnostics"
  },
  "limits": {
    "identifierPattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "identifierMaxUtf8Bytes": 128,
    "displayNameMaxUtf8Bytes": 256,
    "handleMaxUtf8Bytes": 256,
    "appNameMaxUtf8Bytes": 128,
    "errorMessageMaxUtf8Bytes": 512,
    "platformFieldMaxUtf8Bytes": 128,
    "deadlineMinLeadMs": 250,
    "deadlineMaxLeadMs": 30000,
    "operationRetentionMs": 86400000,
    "operationRecordQuota": 10000,
    "journalRetentionMs": 86400000,
    "journalEventQuota": 2048,
    "journalEncodedByteQuota": 2097152,
    "endedCallRetentionMs": 300000
  },
  "defaultDeadlineMs": {
    "startCall": 10000,
    "answer": 4000,
    "end": 4000,
    "setMuted": 4000,
    "setHeld": 4000
  },
  "callStates": [
    "incoming",
    "outgoing",
    "connecting",
    "active",
    "held",
    "ended"
  ],
  "callDirections": [
    "incoming",
    "outgoing"
  ],
  "endReasons": [
    "localHangup",
    "declined",
    "remoteEnded",
    "callerCancelled",
    "unanswered",
    "busy",
    "failed",
    "answeredElsewhere",
    "declinedElsewhere"
  ],
  "commandTypes": [
    "startCall",
    "answer",
    "end",
    "setMuted",
    "setHeld"
  ],
  "commandStatuses": [
    "applied",
    "rejected",
    "timedOut",
    "unknown"
  ],
  "operationLookupStatuses": [
    "available",
    "unavailable",
    "generationMismatch"
  ],
  "sessionOpenStatuses": [
    "fresh",
    "resumed",
    "resynced"
  ],
  "errorCodes": [
    "invalidArgument",
    "notConfigured",
    "callNotFound",
    "busy",
    "invalidState",
    "unsupported",
    "permissionDenied",
    "platformRejected",
    "mediaNotReady",
    "deadlineExceeded",
    "conflict",
    "journalGap",
    "nativeUnavailable",
    "internal"
  ],
  "eventKinds": [
    "callChanged",
    "operationCompleted",
    "resyncRequired"
  ],
  "eventSources": [
    "local",
    "platform",
    "signaling",
    "media",
    "recovery"
  ],
  "capabilities": [
    "nativeCalling",
    "durableReplay",
    "providerManagedSignaling",
    "hold",
    "mute"
  ]
}
