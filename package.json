{
  "name": "callx-development",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private Callx contract, reference-model and native development tooling",
  "license": "MIT",
  "scripts": {
    "contract:test": "node contracts/v0/validate.mjs",
    "native:check": "sh tool/check_native_sources.sh",
    "native:sync": "sh tool/sync_native_sources.sh",
    "native:ios:test": "cd native/ios && swift test",
    "native:android:test": "packages/flutter/example/android/gradlew -p native/android test",
    "test": "node --test src/*.test.ts tool/*.test.mjs",
    "test:all": "sh tool/test-all.sh",
    "test:quick": "sh tool/test-all.sh quick",
    "app": "node tool/app.mjs",
    "android:flutter": "node tool/app.mjs flutter android",
    "android:rn": "node tool/app.mjs rn android",
    "ios:flutter": "node tool/app.mjs flutter ios",
    "ios:rn": "node tool/app.mjs rn ios",
    "build:android": "node tool/app.mjs flutter android --build-only && node tool/app.mjs rn android --build-only",
    "build:ios": "node tool/app.mjs flutter ios --build-only && node tool/app.mjs rn ios --build-only",
    "typecheck": "tsc --noEmit",
    "push:test": "node tool/send-test-push.mjs",
    "call:console": "node tool/call-console.mjs",
    "media:server": "docker run --rm --name callx-livekit -p 7880:7880 -p 7881:7881 -p 7882:7882/udp livekit/livekit-server:v1.13.7 --dev --bind 0.0.0.0 --node-ip 127.0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.7.2"
  }
}
