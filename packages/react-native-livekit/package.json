{
  "name": "@bear-block/callx-livekit",
  "version": "0.1.0",
  "description": "LiveKit media adapter for @bear-block/callx: call audio that starts natively when a call is answered",
  "keywords": [
    "react-native",
    "expo",
    "livekit",
    "callkit",
    "telecom",
    "voip",
    "calls",
    "webrtc"
  ],
  "license": "MIT",
  "homepage": "https://bear-block.github.io/callx/",
  "bugs": {
    "url": "https://github.com/bear-block/callx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bear-block/callx.git",
    "directory": "packages/react-native-livekit"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./app.plugin": "./app.plugin.cjs"
  },
  "files": [
    "lib",
    "app.plugin.cjs",
    "android",
    "ios",
    "callx-livekit.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@expo/config-plugins": "57.0.9",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@bear-block/callx": "^0.1.0",
    "@expo/config-plugins": ">=57.0.0 <58.0.0",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/bear-block"
    },
    {
      "type": "individual",
      "url": "https://buymeacoffee.com/bearblock"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
