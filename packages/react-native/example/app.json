{
  "expo": {
    "name": "Callx · RN Preview",
    "slug": "callx-rn-preview",
    "version": "0.0.1",
    "scheme": "callx-preview",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      ["@bear-block/callx/app.plugin", {
        "microphonePermission": "Allow Callx to use your microphone for voice calls.",
        "iosVoip": false,
        "androidNotifications": false
      }]
    ],
    "ios": {
      "bundleIdentifier": "dev.callx.preview.rn"
    },
    "android": {
      "package": "dev.callx.preview.rn"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
