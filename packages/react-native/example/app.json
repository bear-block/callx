{
  "expo": {
    "name": "Callx \u00b7 RN Preview",
    "slug": "callx-rn-preview",
    "version": "0.0.1",
    "scheme": "callx-preview",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "@bear-block/callx/app.plugin",
        {
          "microphonePermission": "Allow Callx to use your microphone for voice calls.",
          "iosVoip": false,
          "androidNotifications": true,
          "bootstrap": false
        }
      ],
      "@bear-block/callx-livekit/app.plugin",
      "./device-host/app.plugin.cjs"
    ],
    "ios": {
      "bundleIdentifier": "dev.callx.preview.rn"
    },
    "android": {
      "package": "dev.bearblock.callx"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
