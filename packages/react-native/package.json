{
  "name": "@bear-block/callx",
  "version": "0.0.0-preview.1",
  "private": true,
  "description": "Callx SDK experience preview — no native calling implementation",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./preview": {
      "types": "./lib/preview.d.ts",
      "default": "./lib/preview.js"
    }
  },
  "files": [
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
