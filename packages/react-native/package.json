{
  "name": "@bear-block/callx",
  "version": "0.2.2",
  "description": "Native call coordination for React Native using CallKit and Android Core-Telecom",
  "keywords": [
    "react-native",
    "expo",
    "callkit",
    "pushkit",
    "telecom",
    "voip",
    "calls",
    "incoming-call",
    "android",
    "ios"
  ],
  "license": "MIT",
  "homepage": "https://bear-block.github.io/callx/",
  "bugs": {
    "url": "https://github.com/bear-block/callx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bear-block/callx.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./app.plugin": "./app.plugin.cjs",
    "./preview": {
      "types": "./lib/preview.d.ts",
      "default": "./lib/preview.js"
    },
    "./video": {
      "types": "./lib/video.d.ts",
      "react-native": "./src/video.ts",
      "default": "./lib/video.js"
    },
    "./ui": {
      "types": "./lib/ui.d.ts",
      "react-native": "./src/ui.tsx",
      "default": "./lib/ui.js"
    },
    "./presentation": {
      "types": "./lib/presentation.d.ts",
      "default": "./lib/presentation.js"
    }
  },
  "files": [
    "lib",
    "src/video.ts",
    "src/specs",
    "app.plugin.cjs",
    "plugin",
    "android",
    "ios",
    "callx-react-native.podspec",
    "react-native.config.js",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "src/ui.tsx",
    "src/presentation.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@expo/config-plugins": "57.0.9",
    "@types/react": "^19.3.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=57.0.0 <58.0.0",
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "CallxSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.callx.reactnative"
    },
    "ios": {
      "modulesProvider": {
        "Callx": "CallxModule"
      },
      "componentProvider": {
        "CallxVideoView": "CallxVideoComponentView"
      }
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/bear-block"
    },
    {
      "type": "individual",
      "url": "https://buymeacoffee.com/bearblock"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
