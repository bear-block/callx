{
  "name": "@bear-block/callx-testkit",
  "version": "0.2.4",
  "description": "Device-trial tools for callx: a local call console, test push sender and media adapter conformance",
  "keywords": [
    "callx",
    "voip",
    "fcm",
    "apns",
    "push",
    "testing",
    "conformance",
    "livekit"
  ],
  "license": "MIT",
  "homepage": "https://bear-block.github.io/callx/",
  "bugs": {
    "url": "https://github.com/bear-block/callx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bear-block/callx.git",
    "directory": "packages/testkit"
  },
  "type": "module",
  "bin": {
    "callx-console": "src/console.mjs",
    "callx-push": "src/push.mjs",
    "callx-conformance": "src/conformance.mjs"
  },
  "exports": {
    "./console": "./src/console.mjs",
    "./push": "./src/push.mjs",
    "./conformance": "./src/conformance.mjs"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/bear-block"
    },
    {
      "type": "individual",
      "url": "https://buymeacoffee.com/bearblock"
    }
  ],
  "publishConfig": {
    "access": "public"
  }
}
